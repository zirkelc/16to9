      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16to9-Einstellungen"
          }
        }
      }
    },
    "16to9 can now resize windows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16to9 kann jetzt Fenster anpassen."
          }
        }
      }
    },
    "16to9 cannot resize windows yet" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16to9 kann noch keine Fenster anpassen"
          }
        }
      }
    },
    "16to9 is allowed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16to9 ist erlaubt."
          }
        }
      }
    },
    "16to9 needs one permission" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16to9 braucht eine Erlaubnis"
          }
        }
      }
    },
    "16to9 resized “%@”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16to9 hat „%@“ angepasst."
          }
        }
      }
    },
    "16to9 stays in the menu bar. Press" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16to9 bleibt in der Menüleiste. Drücke"
          }
        }
      }
    },
    "A frame on the screen shows the new size before you click." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rahmen auf dem Bildschirm zeigt die neue Größe vor dem Klick."
          }
        }
      }
    },
    "A frame with rulers shows on the screen. Move the window into the frame until its edges are green." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rahmen mit Linealen erscheint auf dem Bildschirm. Schiebe das Fenster in den Rahmen, bis seine Kanten grün sind."
          }
        }
      }
    },
    "A frame with rulers shows the exact size. Resize a window by hand until it fills the frame, or until a canvas or a video in it does." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rahmen mit Linealen zeigt die genaue Größe. Passe ein Fenster von Hand an, bis es oder eine Leinwand darin den Rahmen füllt."
          }
        }
      }
    },
    "A short message with the new size and an Undo button." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kurze Meldung mit der neuen Größe und der Taste „Widerrufen“."
          }
        }
      }
    },
